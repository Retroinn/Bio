# ============================================================================
# B.io — Environment Configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values.
# Variables prefixed with VITE_ are exposed to the browser (frontend bundle).
# All other variables are server-only and MUST NOT be prefixed with VITE_.
# ============================================================================


# ============================================================================
# SUPABASE  (frontend + server)
# ============================================================================
# Project URL — public, safe for frontend.
# Where: Supabase Dashboard → Project Settings → API → Project URL
# Exposure: Frontend (VITE_ prefix required)
# Required: YES
VITE_SUPABASE_URL=YOUR_VALUE

# Anon/Publishable key — public, designed for browser use. RLS protects data.
# Where: Supabase Dashboard → Project Settings → API → anon public
# Exposure: Frontend (VITE_ prefix required)
# Required: YES
VITE_SUPABASE_ANON_KEY=YOUR_VALUE

# Service Role key — FULL database access, bypasses RLS. NEVER put in frontend.
# Where: Supabase Dashboard → Project Settings → API → service_role
# Exposure: SERVER-ONLY (no VITE_ prefix). Use only in Edge Functions or server code.
# Required: YES (for Edge Functions / server-side admin operations)
SUPABASE_SERVICE_ROLE_KEY=YOUR_VALUE

# Database connection string — for server-side scripts / migrations only.
# Where: Supabase Dashboard → Project Settings → Database → Connection string
# Exposure: SERVER-ONLY
# Required: NO (only if running server-side scripts outside Supabase MCP)
# SUPABASE_DB_URL=YOUR_VALUE


# ============================================================================
# GOOGLE OAUTH  (configured in Supabase Dashboard, not in .env)
# ----------------------------------------------------------------------------
# B.io uses Supabase Auth's built-in OAuth. No client ID/secret goes in .env.
#
# Setup steps:
#   1. Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   2. Application type: Web application
#   3. Authorized redirect URIs (add BOTH):
#      - https://<your-supabase-project>.supabase.co/auth/v1/callback
#      - http://localhost:5173/auth/v1/callback  (for local dev if using local Supabase)
#   4. Copy Client ID and Client Secret
#   5. Supabase Dashboard → Authentication → Providers → Google → Enable
#      Paste Client ID and Client Secret there.
#   6. No .env variable needed — Supabase handles the OAuth flow server-side.
# ============================================================================


# ============================================================================
# DISCORD OAUTH  (configured in Supabase Dashboard, not in .env)
# ----------------------------------------------------------------------------
# B.io uses Supabase Auth's built-in OAuth for Discord (identify scope).
#
# Setup steps:
#   1. Discord Developer Portal → Applications → New Application
#   2. OAuth2 → Redirects — add:
#      - https://<your-supabase-project>.supabase.co/auth/v1/callback
#   3. Copy Client ID and Client Secret
#   4. Supabase Dashboard → Authentication → Providers → Discord → Enable
#      Paste Client ID and Client Secret there.
#   5. No .env variable needed — Supabase handles the OAuth flow server-side.
# ============================================================================


# ============================================================================
# IYZICO PAYMENT  (NOT YET IMPLEMENTED — planned for future)
# ----------------------------------------------------------------------------
# The codebase has a `provider` field supporting 'iyzico' in the database
# schema and a notice on the Billing page, but NO iyzico API calls exist yet.
# When implemented, these would go in Edge Function secrets (server-only).
#
# When ready, add these as Supabase Edge Function Secrets (NOT in frontend .env):
#
#   IYZICO_API_KEY=YOUR_VALUE            → sandbox or production API key
#   IYZICO_SECRET_KEY=YOUR_VALUE         → sandbox or production secret key
#   IYZICO_BASE_URL=YOUR_VALUE           → https://sandbox-api.iyzico.com (test)
#                                            https://api.iyzico.com (production)
#   IYZICO_WEBHOOK_URL=YOUR_VALUE        → https://<your-project>.supabase.co/functions/v1/iyzico-webhook
#   IYZICO_CALLBACK_URL=YOUR_VALUE       → https://<your-domain>/dashboard/billing
#
# All iyzico values are SERVER-ONLY. Never prefix with VITE_.
# ============================================================================


# ============================================================================
# SPOTIFY / YOUTUBE / TWITCH / GITHUB API
# ----------------------------------------------------------------------------
# NOT IMPLEMENTED. These appear only as UI icons/labels in widget descriptions
# and landing page showcase. No API calls, no OAuth, no env vars needed.
# When implemented in the future, credentials would be Edge Function secrets.
# ============================================================================


# ============================================================================
# EMAIL
# ----------------------------------------------------------------------------
# NOT IMPLEMENTED. B.io uses Supabase Auth's built-in email for password reset
# and confirmation. No external email service (SendGrid/Resend/SMTP) is wired.
# Supabase handles transactional emails from its dashboard.
# ============================================================================


# ============================================================================
# ANALYTICS
# ----------------------------------------------------------------------------
# NOT IMPLEMENTED externally. B.io uses its own `analytics_events` table in
# Supabase for profile views and link clicks. No external analytics service
# (Google Analytics, Plausible, etc.) is integrated.
# ============================================================================


# ============================================================================
# APP
# ----------------------------------------------------------------------------
# Optional. Used if you need a custom app name in server-side code.
# Exposure: SERVER-ONLY
# Required: NO
# APP_NAME=B.io

# Optional. The public URL where the app is hosted.
# Exposure: Can be frontend (VITE_ prefix) or server-only depending on usage.
# Required: NO
# VITE_APP_URL=https://your-domain.com
